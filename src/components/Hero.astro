---
import { Image } from "astro:assets";
import { mockProfile } from "../data/mockData";
import { translations } from "../data/translations";

const { lang = "es" } = Astro.props;
const t = translations[lang].hero;
---

<section id="home" class="flex items-center justify-center px-6 pt-28 pb-12 lg:pt-36 lg:pb-16 lg:bg-muted/50">
  <div class="container mx-auto max-w-6xl lg:max-w-3xl flex flex-col items-center text-center lg:bg-card lg:border lg:border-border/50 lg:rounded-3xl lg:p-16 lg:shadow-lg lg:shadow-black/5">
    <!-- Profile Photo -->
    <div class="relative">
      <div class="absolute -inset-4 bg-gradient-to-r from-blue-500 via-blue-400 to-blue-600 rounded-full blur-2xl opacity-30 animate-pulse"></div>
      <Image
        src={mockProfile.avatar}
        alt={mockProfile.name}
        width={280}
        height={280}
        loading="eager"
        class="relative w-56 h-56 sm:w-64 sm:h-64 lg:w-72 lg:h-72 rounded-full border-4 border-blue-500/30 shadow-2xl avatar-glow object-cover object-[50%_25%]"
      />
    </div>

    <!-- Name, Title, Location -->
    <div class="mt-3 lg:mt-6 space-y-2">
      <h1 class="text-4xl sm:text-5xl lg:text-5xl font-bold bg-gradient-to-r from-blue-400 via-blue-500 to-blue-600 bg-clip-text text-transparent">
        {mockProfile.name}
      </h1>

      <p class="text-lg sm:text-xl lg:text-2xl text-muted-foreground">
        {mockProfile.title[lang]}
      </p>

      <div class="flex items-center justify-center space-x-2 text-muted-foreground">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-map-pin"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></svg>
        <span>{mockProfile.location}</span>
      </div>
    </div>

    <!-- Bio -->
    <p class="mt-6 max-w-2xl lg:max-w-xl text-base sm:text-lg lg:text-xl text-muted-foreground leading-relaxed">
      {mockProfile.bio[lang]}
    </p>

    <!-- CTA -->
    <a
      href="#contact"
      class="mt-6 lg:mt-8 inline-flex items-center space-x-3 px-8 py-4 bg-blue-500 hover:bg-blue-600 text-white rounded-full text-lg font-medium transition-all duration-300 ease-out shadow-lg shadow-blue-500/25 hover:scale-[1.02] hover:shadow-xl hover:shadow-blue-500/20"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
      </svg>
      <span>Contáctame</span>
    </a>
  </div>
</section>
