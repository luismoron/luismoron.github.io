---
import { mockProfile, mockSkills, yearsOfExperience } from "../data/mockData";
import { translations } from "../data/translations";

const { lang = "es" } = Astro.props;
const t = translations[lang].about;
const { aboutText } = mockProfile;
const allSkills = mockSkills.map((skill) => skill.name);

const getIcon = (type) => {
  switch (type) {
    case 'Server': return '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-server"><rect width="20" height="8" x="2" y="2" rx="2" ry="2"/><rect width="20" height="8" x="2" y="14" rx="2" ry="2"/><line x1="6" x2="6.01" y1="6" y2="6"/><line x1="6" x2="6.01" y1="18" y2="18"/></svg>';
    case 'Database': return '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-database"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5V19A9 3 0 0 0 21 19V5"/><path d="M3 12A9 3 0 0 0 21 12"/></svg>';
    case 'Cpu': return '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-cpu"><rect width="16" height="16" x="4" y="4" rx="2"/><rect width="6" height="6" x="9" y="9" rx="1"/><path d="M15 2v2"/><path d="M15 20v2"/><path d="M2 15h2"/><path d="M2 9h2"/><path d="M20 15h2"/><path d="M20 9h2"/><path d="M9 2v2"/><path d="M9 20v2"/></svg>';
    case 'Terminal': return '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-terminal"><polyline points="4 17 10 11 4 5"/><line x1="12" x2="20" y1="19" y2="19"/></svg>';
    case 'Code': return '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-code"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>';
    case 'Smartphone': return '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-smartphone"><rect width="14" height="20" x="5" y="2" rx="2" ry="2"/><path d="M12 18h.01"/></svg>';
    case 'Globe': return '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-globe"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>';
    default: return '';
  }
};
---

<section id="about" class="py-16 px-4">
  <div class="container mx-auto max-w-4xl">

    <!-- About Header -->
    <div class="text-center mb-12">
      <h2 class="text-3xl font-bold mb-4 text-foreground">
        {aboutText.title[lang]}
      </h2>
      <p class="text-base sm:text-lg text-muted-foreground max-w-2xl mx-auto leading-relaxed">
        {aboutText.intro[lang]}
      </p>
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-2 gap-4 mb-12">
      <div class="text-center p-4 bg-card rounded-xl border border-border">
        <div class="text-3xl font-bold text-blue-500">
          50+
        </div>
        <div class="text-sm text-muted-foreground">
          {t.stats?.projects || 'Proyectos'}
        </div>
      </div>
      <div class="text-center p-4 bg-card rounded-xl border border-border">
        <div class="text-3xl font-bold text-blue-500">
          {yearsOfExperience}+
        </div>
        <div class="text-sm text-muted-foreground">
          {t.stats?.years || 'Años'}
        </div>
      </div>
    </div>

    <!-- About Text -->
    <div class="space-y-4 mb-12">
      {aboutText.body.map((paragraph) => (
        <p class="text-muted-foreground leading-relaxed text-sm sm:text-base">
          {paragraph[lang]}
        </p>
      ))}
    </div>

    <!-- Highlights -->
    <div class="space-y-3 mb-12">
      <h3 class="text-lg font-semibold text-foreground">
        {t.subtitle || 'Especialidades'}
      </h3>
      {mockProfile.aboutHighlights.map((highlight) => (
        <div class="flex items-start space-x-3 p-4 bg-card rounded-xl border border-border card-hover">
          <div class="p-2 bg-blue-500/10 rounded-lg text-blue-500">
            <Fragment set:html={getIcon(highlight.iconType)} />
          </div>
          <div class="flex-1 min-w-0">
            <h4 class="font-medium text-sm sm:text-base">
              {highlight.title[lang]}
            </h4>
            <p class="text-xs sm:text-sm text-muted-foreground line-clamp-2">
              {highlight.description[lang]}
            </p>
          </div>
        </div>
      ))}
    </div>

    <!-- Skills Pills -->
    <div class="space-y-4">
      <h3 class="text-lg font-semibold text-foreground">
        Tecnologías
      </h3>
      <div class="flex flex-wrap gap-2">
        {allSkills.map((skill) => (
          <span class="inline-flex items-center rounded-full bg-blue-500/10 text-blue-400 px-3 py-1.5 text-xs sm:text-sm font-medium border border-blue-500/20">
            {skill}
          </span>
        ))}
      </div>
    </div>

  </div>
</section>
