---
const { currentLang = "es", variant = "floating" } = Astro.props;

const inactiveBase =
  variant === "floating"
    ? "text-gray-400 hover:text-white"
    : "text-muted-foreground hover:text-foreground";
---

<div class={variant === "floating" ? "fixed bottom-6 left-6 z-50 animate-in fade-in slide-in-from-bottom-4 duration-500" : "flex items-center rounded-full border border-border bg-card p-1"}>
  <div class={variant === "floating" ? "bg-black/80 backdrop-blur-md rounded-full p-1.5 flex items-center shadow-lg border border-white/10" : "flex items-center"}>
    <a
      href="/"
      class={`px-4 py-2 rounded-full text-sm font-bold transition-all duration-300 ${
        currentLang === "es"
          ? "bg-gradient-to-r from-blue-600 to-indigo-600 text-white shadow-md transform scale-105"
          : inactiveBase
      }`}
    >
      ES
    </a>
    <a
      href="/en/"
      class={`px-4 py-2 rounded-full text-sm font-bold transition-all duration-300 ${
        currentLang === "en"
          ? "bg-gradient-to-r from-blue-600 to-indigo-600 text-white shadow-md transform scale-105"
          : inactiveBase
      }`}
    >
      EN
    </a>
  </div>
</div>
