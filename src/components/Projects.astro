---
import { mockProjects } from "../data/mockData";
import { translations } from "../data/translations";
import { Image } from "astro:assets";

const { lang = "es" } = Astro.props;
const t = translations[lang].projects;
---

<section id="projects" class="py-16 px-4 sm:px-6 lg:px-8">
  <div class="container mx-auto max-w-6xl">
    <div class="text-center mb-10">
      <h2 class="text-2xl sm:text-3xl font-bold mb-3 text-foreground">
        {t.title}
      </h2>
      <p class="text-sm sm:text-base text-muted-foreground max-w-xl mx-auto">
        {t.description}
      </p>
    </div>

    <!-- Desktop Grid (hidden on mobile) -->
    <div class="hidden md:grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {mockProjects.map((project) => (
        <div class="bg-card rounded-xl border border-border overflow-hidden transition-all duration-300 ease-out hover:-translate-y-1 hover:border-blue-500/50 hover:shadow-xl hover:shadow-blue-500/10">
          {project.image && (
            <div class="relative h-40 overflow-hidden">
              <Image
                src={project.image}
                alt={project.name}
                width={320}
                height={160}
                class="w-full h-full object-cover"
                loading="lazy"
              />
            </div>
          )}
          <div class="p-4">
            <div class="flex items-center justify-between mb-2">
              <h3 class="text-base font-bold truncate">{project.name}</h3>
              {project.featured && (
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="text-yellow-500 fill-yellow-500 flex-shrink-0">
                  <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                </svg>
              )}
            </div>
            <div class="flex flex-wrap gap-1.5 mb-3">
              {project.tech.slice(0, 3).map((tech) => (
                <span class="inline-flex items-center rounded-full bg-blue-500/10 text-blue-400 px-2 py-0.5 text-xs">
                  {tech}
                </span>
              ))}
              {project.tech.length > 3 && (
                <span class="inline-flex items-center text-xs text-muted-foreground">
                  +{project.tech.length - 3}
                </span>
              )}
            </div>
            <div class="flex items-center gap-3 pt-3 border-t border-border">
              {project.github && (
                <a
                  href={project.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center gap-1.5 text-xs text-muted-foreground hover:text-blue-400 transition-colors"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-github"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
                  <span>Code</span>
                </a>
              )}
              {project.demo && (
                <a
                  href={project.demo}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center gap-1.5 text-xs text-muted-foreground hover:text-blue-400 transition-colors"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-external-link"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
                  <span>Demo</span>
                </a>
              )}
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Mobile Carousel (hidden on desktop) -->
    <div class="md:hidden carousel-snap flex gap-4 overflow-x-auto hide-scrollbar pb-4 -mx-4 px-4 snap-x">
      {mockProjects.map((project) => (
        <div class="flex-shrink-0 w-72 bg-card rounded-xl border border-border overflow-hidden transition-transform duration-200 active:scale-[0.98] snap-start">
          {project.image && (
            <div class="relative h-40 overflow-hidden">
              <Image
                src={project.image}
                alt={project.name}
                width={320}
                height={160}
                class="w-full h-full object-cover"
                loading="lazy"
              />
            </div>
          )}
          <div class="p-4">
            <div class="flex items-center justify-between mb-2">
              <h3 class="text-base font-bold truncate">{project.name}</h3>
              {project.featured && (
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="text-yellow-500 fill-yellow-500 flex-shrink-0">
                  <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                </svg>
              )}
            </div>
            <div class="flex flex-wrap gap-1.5 mb-3">
              {project.tech.slice(0, 3).map((tech) => (
                <span class="inline-flex items-center rounded-full bg-blue-500/10 text-blue-400 px-2 py-0.5 text-xs">
                  {tech}
                </span>
              ))}
              {project.tech.length > 3 && (
                <span class="inline-flex items-center text-xs text-muted-foreground">
                  +{project.tech.length - 3}
                </span>
              )}
            </div>
            <div class="flex items-center gap-3 pt-3 border-t border-border">
              {project.github && (
                <a
                  href={project.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center gap-1.5 text-xs text-muted-foreground hover:text-blue-400 transition-colors"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-github"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
                  <span>Code</span>
                </a>
              )}
              {project.demo && (
                <a
                  href={project.demo}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center gap-1.5 text-xs text-muted-foreground hover:text-blue-400 transition-colors"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-external-link"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
                  <span>Demo</span>
                </a>
              )}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
