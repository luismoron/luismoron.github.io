---
import { mockExperience } from "../data/mockData";
import { translations } from "../data/translations";

const { lang = "es" } = Astro.props;
const t = translations[lang].experience;
---

<section id="experience" class="py-16 px-4 sm:px-6 lg:px-12">
  <div class="container mx-auto max-w-4xl lg:max-w-5xl">
    <div class="text-center mb-10">
      <h2 class="text-2xl sm:text-3xl font-bold mb-3 text-foreground">
        {t.title}
      </h2>
      <p class="text-sm sm:text-base text-muted-foreground max-w-xl mx-auto">
        {t.description}
      </p>
    </div>

    <div class="relative border-l-2 border-blue-500/30 ml-4 space-y-8">
      {mockExperience.map((job) => (
        <div class="relative pl-6 sm:pl-8">
          <span class="absolute -left-[9px] top-1 h-4 w-4 rounded-full bg-blue-500 ring-4 ring-background" />

          <div class="mb-3">
            <h3 class="text-base sm:text-lg font-bold">{job.title}</h3>
            <div class="flex flex-wrap items-center gap-2 text-sm text-blue-400 mt-1">
              <span>{job.company}</span>
              <span class="text-muted-foreground">•</span>
              <span class="text-muted-foreground">{job.periodText[lang]}</span>
            </div>
          </div>

          <div class="bg-card p-4 sm:p-5 rounded-xl border border-border transition-all duration-300 ease-out hover:border-blue-500/30 hover:bg-blue-500/5">
            <p class="text-xs sm:text-sm text-muted-foreground leading-relaxed">
              {job.description[lang]}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
